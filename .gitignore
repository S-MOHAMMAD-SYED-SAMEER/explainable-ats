# This project is a standalone repository. The generic rules below used to come
# from a monorepo's root .gitignore; the project-specific rules beneath them
# are the ones that are particular to Explainable ATS.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Env
.env
.env.local
.env.*.local

# Local SQLite databases (conversation memory, etc.)
*.sqlite
*.sqlite3
*.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# --- Project-specific ---
# SQLite's WAL sidecar files, which exist only while the database is
# open — long enough for a `git add -A` during a running server to
# sweep a binary journal into a commit.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Reserved for generated evaluation output. No evaluation harness exists yet, so
# nothing writes here today.
server/eval-results/
