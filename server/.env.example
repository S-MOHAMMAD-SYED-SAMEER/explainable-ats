# Copy to `.env` and fill in only what you need. Every value below has a working
# default: with no .env file at all the server migrates, tests and runs — with
# no API key and no database server.
#
# `.env` is gitignored repo-wide. This file is committed and must never contain
# a real value.

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string. Leave EMPTY for local development: with no URL
# the server uses a local SQLite file, which needs no server and no account.
# Setting a postgres:// URL is the only change needed to run against a hosted
# database.
DATABASE_URL=

# Where the local SQLite database lives. Optional.
SQLITE_PATH=

# --- AI provider ------------------------------------------------------------

# "mock" or "anthropic". "mock" is the default and replays registered fixtures
# deterministically: it costs nothing, needs no key, and makes a walkthrough
# behave identically every run. Asking for a provider that is not implemented
# fails loudly rather than quietly falling back — a run that believed it called
# Claude but actually replayed a fixture would invalidate any result taken from it.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic. API spend is real money.
ANTHROPIC_API_KEY=

# Sonnet 5 for resume ranking is fixed by CLAUDE.md. Do not raise or lower the
# tier without deciding to.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Authentication ---------------------------------------------------------
#
# REQUIRED. Without it nobody can sign in and every protected endpoint answers
# 401 — the correct behaviour for a machine nobody has configured, and the
# reason there is no built-in default password.
#
# Generate one:  npm run hash-password
#
# The password is read from stdin, never from an argument, so it does not land
# in shell history or the process list. Only the hash goes in this file.
OPERATOR_PASSWORD_HASH=

# Whether anonymous callers may read the allow-listed demo routes.
#
# Default false, and false is the safe direction: an environment that forgets
# this behaves exactly as it did before the flag existed — fully gated.
#
# Turning it on opens a short, literal list of GET routes (jobs, rankings,
# evaluations, audit) over the invented dataset in src/demo. It is NOT a
# second credential: an allowed request is granted no session and no CSRF
# token, so `operatorOf` still throws and the one write route — recording a
# recruiter decision — still answers 401. See src/auth/middleware.ts.
#
# Set this to true only where the database holds demo data and nothing else.
DEMO_PUBLIC_READONLY=false

# How long a session lasts. Fixed at sign-in — activity does not extend it.
SESSION_TTL_HOURS=12

# Whether session cookies carry `Secure`. Default true. Browsers refuse Secure
# cookies over plain HTTP, so local development over http://localhost needs
# this false. A deliberate opt-out reported at every boot, rather than a default
# that would silently ship insecure cookies.
# COOKIE_SECURE=false

# --- Deployment -------------------------------------------------------------

# How many reverse proxies sit in front of this server.
#
# 0 (the default) means none: `X-Forwarded-For` is ignored and the client
# address is the socket address. Set it ONLY to the number of proxies that
# genuinely terminate the connection — 1 for a single managed host.
#
# Both mistakes are real and fail in opposite directions. Too low: every request
# looks like it came from the proxy, so the whole internet shares one rate-limit
# bucket, and the endpoint that breaks is sign-in. Too high: the app believes a
# hop that is not there, so a client can send its own X-Forwarded-For and pick
# its own bucket.
TRUST_PROXY=0

# Where the built front end lives. Optional — defaults to explainable-ats/web/dist.
# The API serves the dashboard from the same origin, which is what allows the
# session cookie to stay SameSite=Strict and the CORS allow-list to stay empty.
WEB_DIST_DIR=

# Origins permitted to make credentialed cross-origin requests. Empty is
# correct for single-origin serving and is not a gap: the front end is served
# from this same origin, so there are no cross-origin clients.
CORS_ALLOWED_ORIGINS=

# --- Server -----------------------------------------------------------------

# 3200, so this can run at the same time as Projects 1 and 2 during a call.
PORT=3200

# One of: debug, info, warn, error.
LOG_LEVEL=info
